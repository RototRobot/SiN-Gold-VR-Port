* text=auto

# Windows-only formats keep CRLF in the working tree
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf
*.sln             text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf

# Binary
*.dll  binary
*.exe  binary
*.lib  binary
*.pdb  binary
*.png  binary
*.jpg  binary
*.tga  binary
*.docx binary
*.zip  binary
